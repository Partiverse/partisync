{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PartiSync Desktop",
  "version": "0.2.0",
  "identifier": "dev.partisync.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PartiSync · 资产图谱",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": [
        {
          "identifier": "default",
          "description": "T03 默认能力集： main 窗口可调用 6 个 IPC command（get_stats / list / search / cas_stats / duplicates / jobs， src/ipc.rs）。 Tauri 2 的 process command（#[tauri::command]）注册后默认对声明 capability 的窗口可调用， 此处仅显式声明窗口范围与所需核心权限（core:default）。 mcp_call 侧车连通属 T05 范畴， 本期不暴露。",
          "windows": ["main"],
          "permissions": ["core:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "PartiSync desktop shell (M6-WP03 T01 scaffold)",
    "longDescription": "Tauri 2 桌面壳骨架：SPEC M6-WP03 / ADR-0024。M6-WP03-T01 仅交付最小 buildable scaffold，IPC 与 MCP 侧车后续任务。"
  }
}